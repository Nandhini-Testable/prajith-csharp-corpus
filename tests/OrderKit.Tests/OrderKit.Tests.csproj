<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="ErrorLog">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <!-- A .NET Framework test host exists only on Windows (or under Mono). Elsewhere the
         tests run on .NET 8 against the same net472 build of the library. -->
    <TargetFramework Condition=" !$([MSBuild]::IsOSPlatform('Windows')) ">net8.0</TargetFramework>
    <AssemblyName>OrderKit.Tests</AssemblyName>
    <RootNamespace>OrderKit.Tests</RootNamespace>
    <!-- LangVersion is deliberately NOT set. It defaults from the TargetFramework,
         which is what makes the family axis one number instead of two. -->
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- A solution-wide /p:ErrorLog names one SARIF file for every project. Each library
         logs under its own obj folder; this project builds last and merges those logs
         into the file that was asked for. Its own diagnostics are not logged. -->
    <SolutionErrorLog>$(ErrorLog)</SolutionErrorLog>
    <SolutionErrorLog Condition=" $(SolutionErrorLog.Contains(',')) ">$(SolutionErrorLog.Substring(0, $(SolutionErrorLog.IndexOf(','))))</SolutionErrorLog>
    <ErrorLog></ErrorLog>
  </PropertyGroup>


  <ItemGroup>
    <ProjectReference Include="..\..\src\OrderKit.Domain\OrderKit.Domain.csproj" />
    <ProjectReference Include="..\..\src\OrderKit.Contracts\OrderKit.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Services\OrderKit.Pricing\OrderKit.Pricing.csproj" />
    <ProjectReference Include="..\..\src\Services\OrderKit.Risk\OrderKit.Risk.csproj" />
    <ProjectReference Include="..\..\src\Services\OrderKit.Reporting\OrderKit.Reporting.csproj" />
  </ItemGroup>

  <UsingTask TaskName="MergeSarif" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Logs ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var runs = new List<string>();
        foreach (var log in Logs)
        {
            if (!File.Exists(log.ItemSpec)) continue;
            string text = File.ReadAllText(log.ItemSpec);
            int key = text.IndexOf("\"runs\"");
            int open = key < 0 ? -1 : text.IndexOf('[', key);
            int close = text.LastIndexOf(']');
            if (open < 0 || close <= open) continue;
            string body = text.Substring(open + 1, close - open - 1).Trim();
            if (body.Length > 0) runs.Add(body);
        }
        File.WriteAllText(Output,
            "{\n  \"$schema\": \"http://json.schemastore.org/sarif-2.1.0\",\n  \"version\": \"2.1.0\",\n  \"runs\": [\n"
            + string.Join(",\n", runs) + "\n  ]\n}\n");
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="MergeAnalysisLogs" AfterTargets="Build" Condition=" '$(SolutionErrorLog)' != '' ">
    <ItemGroup>
      <_AnalysisLog Include="@(ProjectReference->'%(RootDir)%(Directory)obj\%(Filename).sarif')" />
    </ItemGroup>
    <MergeSarif Logs="@(_AnalysisLog)" Output="$(SolutionErrorLog)" />
  </Target>
  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.13.3" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="OpenTelemetry" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
  </ItemGroup>
  <!-- The planted pins belong to the .NET Framework build; the .NET 8 test host cannot
       take the planted Newtonsoft.Json. -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net472' ">
    <PackageReference Include="Newtonsoft.Json" Version="9.0.1" />
    <PackageReference Include="System.Net.Http" Version="4.3.0" />
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.2.3" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.0" />
    <PackageReference Include="BouncyCastle" Version="1.8.1" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="9.32.0.97167" PrivateAssets="all" />
    <PackageReference Include="SecurityCodeScan.VS2019" Version="5.6.7" PrivateAssets="all" />
  </ItemGroup>
</Project>

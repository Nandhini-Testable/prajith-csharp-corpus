<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="ErrorLog">

  <PropertyGroup>
    <TargetFramework>net45</TargetFramework>
    <AssemblyName>OrderKit.Contracts</AssemblyName>
    <RootNamespace>OrderKit.Contracts</RootNamespace>
    <!-- LangVersion is deliberately NOT set. It defaults from the TargetFramework,
         which is what makes the family axis one number instead of two. -->
    <!-- A solution-wide /p:ErrorLog names one SARIF file for every project. Projects that
         compile in parallel would overwrite or interleave it, so each library logs under
         its own obj folder and the test project, which builds last, merges them. -->
    <ErrorLog Condition=" '$(ErrorLog)' != '' ">$(MSBuildProjectDirectory)\obj\$(MSBuildProjectName).sarif,version=2.1</ErrorLog>
  </PropertyGroup>

  <ItemGroup>
    <!-- CELL CONTRADICTION: packages.config is declared for this branch
         but an SDK-style project cannot consume it. See
         PACKAGES-CONFIG.INERT.md and dataset.json branchFunctional. -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OrderKit.Domain\OrderKit.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="8.0.0" PrivateAssets="all" />
    <PackageReference Include="SonarAnalyzer.CSharp" Version="9.32.0.97167" PrivateAssets="all" />
    <PackageReference Include="SecurityCodeScan.VS2019" Version="5.6.7" PrivateAssets="all" />
  </ItemGroup>
</Project>
